{
    "tasks": {
        "dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "deno task test:unit --run && deno task test:e2e",
		"test:unit": "vitest",
		"test:e2e": "PW_DISABLE_TS_ESM=1 playwright test"
    },
    "imports": {
        "@playwright/test": "npm:@playwright/test@^1.49.1",
		"@sveltejs/adapter-node": "npm:@sveltejs/adapter-node@^5.2.12",
		"@sveltejs/kit": "npm:@sveltejs/kit@^2.16.0",
		"@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^5.0.0",
		"@testing-library/jest-dom": "npm:@testing-library/jest-dom@^6.6.3",
		"@testing-library/svelte": "npm:@testing-library/svelte@^5.2.4",
		"jsdom": "npm:jsdom@^26.0.0",
		"svelte": "npm:svelte@^5.0.0",
		"svelte-check": "npm:svelte-check@^4.0.0",
		"typescript": "npm:typescript@^5.0.0",
		"vite": "npm:vite@^6.2.5",
		"vitest": "npm:vitest@^3.0.0"
    },
    "fmt": {
        // Fight me
        "useTabs": true
    }
}
